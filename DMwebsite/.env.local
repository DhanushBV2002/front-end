# Where enquiry emails are delivered.
CONTACT_TO_EMAIL=dhanushbv2002@gmail.com

# Verified sender. `onboarding@resend.dev` works for testing without a domain;
# once dhanuasha.com is verified in Resend use e.g.
# "DHANUASHA Website <website@dhanuasha.com>"
CONTACT_FROM_EMAIL=DHANUASHA Website <onboarding@resend.dev>

# OPTION B — POST each enquiry as JSON to any webhook endpoint.
# Works with Formspree, Zapier, Make, Google Apps Script, Slack, n8n, etc.
CONTACT_WEBHOOK_URL=https://formspree.io/f/mzezbrrl

# OPTIONAL — set to "false" to stop writing `.data/contact-enquiries.jsonl`.
# That file is a local safety net when no provider is configured; it is never
# written on Vercel (ephemeral filesystem).
CONTACT_FILE_BACKUP=true